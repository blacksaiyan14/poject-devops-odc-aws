pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDENTIALS = 'docker-creds'
        DOCKERHUB_USER = 'blacksaiyan14'
        BACKEND_REPO = 'odc-backend'
        FRONTEND_REPO = 'odc-frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Cloning repository from git 📥"
                checkout scm
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                echo "🐳 Building the backend image"
                sh "docker build -t ${DOCKERHUB_USER}/${BACKEND_REPO}:latest -f ./Backend/odc/dockerfile ./Backend/odc"
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                echo "🐳 Building the frontend image"
                sh "docker build -t ${DOCKERHUB_USER}/${FRONTEND_REPO}:latest -f ./Frontend/dockerfile ./Frontend"
            }
        }

        stage('Push Docker Images') {
            steps {
                echo "Pushing images to Docker Hub 🚀"
                withCredentials([usernamePassword(credentialsId: 'docker-creds', passwordVariable: 'DOCKER_HUB_PASS', usernameVariable: 'DOCKER_HUB_USER')]) {
                    // Créer un dépôt temporaire pour stocker les identifiants
                    sh '''
                        echo "Tentative de connexion à Docker Hub avec l'utilisateur: $DOCKER_HUB_USER"
                        
                        # Créer un répertoire temporaire pour les identifiants Docker
                        mkdir -p /tmp/docker-config
                        
                        # Créer un fichier de configuration Docker personnalisé
                        AUTH_BASE64=$(echo -n "$DOCKER_HUB_USER:$DOCKER_HUB_PASS" | base64)
                        cat > /tmp/docker-config/config.json << EOF
{
  "auths": {
    "https://index.docker.io/v1/": {
      "auth": "$AUTH_BASE64"
    }
  }
}
EOF
                        
                        # Utiliser ce fichier de configuration pour Docker
                        export DOCKER_CONFIG=/tmp/docker-config
                        
                        # Pousser les images
                        docker push ${DOCKERHUB_USER}/${BACKEND_REPO}:latest
                        docker push ${DOCKERHUB_USER}/${FRONTEND_REPO}:latest
                    '''
                }
            }
            post {
                failure {
                    echo "Erreur lors du push des images Docker"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying to Kubernetes 🚢"
                sh '''
                    # Vérifier que le script de déploiement existe
                    if [ -f "./deploy-kubernetes.sh" ]; then
                        echo "Script de déploiement trouvé, exécution..."
                        # Exécuter le script de déploiement
                        sudo ./deploy-kubernetes.sh
                    else
                        echo "ERREUR: Script de déploiement non trouvé!"
                        exit 1
                    fi
                '''
            }
        }


    }

    post {
        failure {
            echo "❌ Pipeline failed. Check Jenkins for details."
        }
        success {
            echo "✅ Pipeline succeeded! Application is deployed on Kubernetes with Ingress. 🎉"
            echo "Access the application at http://odc.local"
        }
    }
}
